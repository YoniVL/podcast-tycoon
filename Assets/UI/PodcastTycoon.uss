/* Podcast Tycoon — slice 1 UI. Committed dark "studio" look; club colours are
   layered on specific elements at runtime from Theme.cs. */

.app {
    flex-grow: 1;
    background-color: rgb(21, 20, 27);
    color: rgb(236, 233, 242);
    font-size: 15px;
}

.screen {
    flex-grow: 1;
    align-items: center;
    padding: 24px;
}

.column {
    width: 90%;
    max-width: 860px;
    flex-grow: 1;
}

/* The main gameplay screen gets the most benefit from landscape's extra width. */
.column-wide {
    width: 94%;
    max-width: 1180px;
    flex-grow: 1;
}

.scroll {
    flex-grow: 1;
    width: 100%;
}

/* This Week: the decision (rundown/push/cards) and its consequence (levers/preview)
   sit side by side instead of stacking, so landscape actually buys you something. */
.week-columns { flex-direction: row; flex-wrap: wrap; align-items: flex-start; }
.week-col-left { flex-grow: 1.6; flex-shrink: 1; flex-basis: 420px; min-width: 380px; margin-right: 18px; }
.week-col-right { flex-grow: 1; flex-shrink: 1; flex-basis: 320px; min-width: 300px; }

/* ---- typography ---- */
/* A pixel display face for short, shouty text — titles, tags, tab labels, the
   stat numbers. Never for prose: it's chunky and hard to read at length. */
.setup-logo {
    margin-bottom: 10px;
}

.h1 {
    -unity-font-definition: url("Fonts/PressStart2P-Regular.ttf");
    font-size: 26px;
    color: rgb(244, 242, 250);
    margin-bottom: 6px;
    white-space: normal;
    -unity-text-align: middle-left;
}

.h2 {
    font-size: 19px;
    -unity-font-style: bold;
    color: rgb(240, 238, 248);
    margin-top: 6px;
    margin-bottom: 6px;
}

.eyebrow {
    -unity-font-definition: url("Fonts/PressStart2P-Regular.ttf");
    font-size: 11px;
    color: rgb(231, 165, 68);
    letter-spacing: 1px;
    margin-bottom: 8px;
}

.muted { color: rgb(150, 144, 165); }
.dim { color: rgb(178, 172, 190); }
.good { color: rgb(92, 195, 137); }
.bad { color: rgb(232, 106, 102); }
.body { white-space: normal; color: rgb(206, 202, 216); }
.tabnum { -unity-font-style: normal; }

/* ---- panels ---- */
.panel {
    background-color: rgb(31, 30, 40);
    border-color: rgb(48, 46, 60);
    border-width: 2px;
    border-radius: 10px;
    padding: 12px;
    margin-bottom: 10px;
}

.panel-tight { padding: 10px; }

.row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.row-wrap { flex-direction: row; flex-wrap: wrap; }

/* ---- This Week wizard ---- */
.step-indicator { margin-bottom: 14px; }
.step-chip {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(120, 114, 132);
    background-color: rgb(24, 23, 31);
    border-color: rgb(45, 43, 56);
    border-width: 2px;
    border-radius: 6px;
    padding: 6px 14px;
    margin-right: 8px;
    margin-bottom: 6px;
}
.step-chip.active { color: rgb(22, 21, 27); background-color: rgb(231, 165, 68); border-color: rgb(231, 165, 68); }
.step-chip.done { color: rgb(200, 196, 210); border-color: rgb(90, 86, 104); }

.step-nav { margin-top: 4px; margin-bottom: 10px; }

/* ---- recording progress ---- */
.rec-dot {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    background-color: rgb(45, 43, 56);
    border-color: rgb(64, 61, 78);
    border-width: 2px;
    margin-right: 6px;
    margin-bottom: 4px;
}
.rec-dot.done { background-color: rgb(231, 165, 68); border-color: rgb(255, 205, 140); }

/* ---- studio backdrop (recording screen) ---- */
.studio-frame {
    width: 100%;
    position: relative;
    margin-bottom: 10px;
    border-width: 2px;
    border-color: rgb(48, 46, 60);
    overflow: hidden;
    background-color: rgb(10, 9, 14);
}
.studio-layer {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

/* ---- collapsible sections ---- */
.collapsible { margin-bottom: 8px; }

.collapsible-header {
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    background-color: rgb(26, 25, 33);
    border-color: rgb(48, 46, 60);
    border-width: 2px;
    border-radius: 8px;
    overflow: hidden;
}

.collapsible-chevron { color: rgb(231, 165, 68); margin-right: 8px; font-size: 12px; flex-shrink: 0; }
.collapsible-title { font-size: 14px; -unity-font-style: bold; color: rgb(236, 233, 242); flex-shrink: 0; }
.collapsible-summary {
    font-size: 12px;
    color: rgb(150, 144, 165);
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-left: 8px;
}

/* ---- pixel portraits ---- */
.portrait {
    -unity-background-scale-mode: scale-to-fit;
    border-radius: 0;
}

.portrait-inline { margin-right: 8px; }

.divider {
    height: 1px;
    background-color: rgb(48, 46, 60);
    margin-top: 10px;
    margin-bottom: 10px;
}

/* ---- stat strip ---- */
/* A single thin row: icon + number, full explanation lives in the tooltip
   (and in Help) instead of a permanently-visible label + paragraph. */
.statstrip { flex-direction: row; flex-wrap: wrap; align-items: center; padding: 6px 4px; }

.statchip {
    align-items: center;
    background-color: rgb(24, 23, 31);
    border-color: rgb(45, 43, 56);
    border-width: 1px;
    border-radius: 8px;
    padding: 4px 10px 4px 6px;
    margin-right: 6px;
    margin-bottom: 4px;
}

.statchip-value {
    -unity-font-definition: url("Fonts/PressStart2P-Regular.ttf");
    font-size: 13px;
    color: rgb(240, 238, 248);
    margin-left: 7px;
}

.stat {
    background-color: rgb(24, 23, 31);
    border-color: rgb(45, 43, 56);
    border-width: 1px;
    border-radius: 8px;
    padding: 8px 12px;
    margin-right: 8px;
    margin-bottom: 8px;
    width: 148px;
}

.stat-label {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(140, 134, 156);
    letter-spacing: 1px;
}

.stat-value {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(240, 238, 248);
}

.stat-note {
    font-size: 10px;
    color: rgb(150, 144, 165);
    margin-top: 3px;
    white-space: normal;
}

/* ---- buttons ----
   A chunkier, game-ier press: a heavier bottom edge reads as depth, and it
   thins out on :active so the button visibly "presses" when clicked. */
.btn {
    -unity-font-style: bold;
    font-size: 14px;
    padding: 9px 16px;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(64, 61, 78);
    border-bottom-width: 4px;
    border-bottom-color: rgb(18, 17, 23);
    background-color: rgb(44, 42, 56);
    color: rgb(236, 233, 242);
    margin-right: 8px;
    margin-bottom: 4px;
}

.btn:hover { background-color: rgb(56, 53, 70); }
.btn:active { border-bottom-width: 2px; margin-top: 2px; }
.btn:disabled { opacity: 0.4; }

.btn-primary {
    background-color: rgb(231, 165, 68);
    color: rgb(22, 21, 27);
    border-color: rgb(255, 205, 140);
    border-bottom-color: rgb(140, 92, 24);
}
.btn-primary:hover { background-color: rgb(240, 184, 104); }

.btn-ghost {
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: rgb(64, 61, 78);
    border-bottom-width: 4px;
    border-bottom-color: rgb(34, 32, 42);
}
.btn-ghost:hover { background-color: rgb(36, 34, 45); }

/* A ghost button used as a "selected" picker (topic/angle/push/stance) gets both
   classes at once. Equal-specificity single-class rules resolve by source order,
   which made a selected pick fall back to the ghost's transparent background while
   keeping btn-primary's dark text — near-black text on the dark panel behind it.
   This two-class rule always wins regardless of source order. */
.btn-ghost.btn-primary {
    background-color: rgb(231, 165, 68);
    color: rgb(22, 21, 27);
    border-color: rgb(255, 205, 140);
    border-bottom-color: rgb(140, 92, 24);
}
.btn-ghost.btn-primary:hover { background-color: rgb(240, 184, 104); }

/* ---- topic cards ---- */
.topiccard {
    background-color: rgb(26, 25, 33);
    border-color: rgb(48, 46, 60);
    border-width: 2px;
    border-radius: 10px;
    padding: 12px;
    margin-bottom: 8px;
}

.topiccard.selected {
    border-color: rgb(231, 165, 68);
    background-color: rgb(35, 31, 27);
}

.topiccard-title { font-size: 15px; -unity-font-style: bold; color: rgb(240, 238, 248); }

/* ---- hand cards ---- */
.card {
    background-color: rgb(26, 25, 33);
    border-color: rgb(48, 46, 60);
    border-width: 2px;
    border-radius: 10px;
    margin-bottom: 8px;
    overflow: hidden;
}
.card-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 6px 10px;
    background-color: rgb(35, 31, 27);
    border-bottom-width: 2px;
    border-bottom-color: rgb(231, 165, 68);
}
.card-head.oneshot {
    background-color: rgb(24, 27, 35);
    border-bottom-color: rgb(120, 170, 255);
}
.card-kind {
    font-size: 9px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(231, 165, 68);
}
.card-kind.oneshot { color: rgb(120, 170, 255); }
.card-body { padding: 10px; }
.card-art {
    align-items: center;
    justify-content: center;
    padding: 8px 0;
    background-color: rgb(19, 18, 24);
}

.chip {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(178, 172, 190);
    background-color: rgb(38, 36, 47);
    border-radius: 4px;
    padding: 2px 6px;
    margin-right: 4px;
    margin-top: 4px;
}

/* ---- surprise badge ---- */
.badge {
    -unity-font-definition: url("Fonts/PressStart2P-Regular.ttf");
    font-size: 12px;
    letter-spacing: 1.5px;
    padding: 5px 10px;
    border-radius: 6px;
    background-color: rgb(44, 42, 56);
    color: rgb(236, 233, 242);
}

/* ---- scoreboard ---- */
.scoreboard {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 14px;
    border-radius: 10px;
    background-color: rgb(17, 16, 22);
    border-width: 1px;
    border-color: rgb(48, 46, 60);
}

.score {
    -unity-font-definition: url("Fonts/PressStart2P-Regular.ttf");
    font-size: 28px;
    color: rgb(244, 242, 250);
    margin-left: 14px;
    margin-right: 14px;
}

.club-name { font-size: 15px; -unity-font-style: bold; color: rgb(220, 216, 230); }

/* ---- sliders ---- */
.prep-row { flex-direction: row; align-items: center; margin-bottom: 4px; }
.prep-name {
    width: 92px;
    font-size: 13px;
    -unity-font-style: bold;
    flex-shrink: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.prep-name-wide { width: 176px; }
.prep-slider { flex-grow: 1; margin-right: 8px; }
.prep-value { width: 26px; -unity-font-style: bold; -unity-text-align: middle-right; }

.prep-meter {
    -unity-font-style: bold;
    font-size: 12px;
}
.prep-meter.over { color: rgb(232, 106, 102); }

/* The step-header prep readout — a chip in the same family as .step-chip, not
   bare text, so it doesn't get lost as an unlabelled fragment next to them. */
.prep-meter-chip {
    font-size: 14px;
    color: rgb(231, 165, 68);
    background-color: rgb(24, 23, 31);
    border-color: rgb(231, 165, 68);
    border-width: 2px;
    border-radius: 6px;
    padding: 6px 14px;
    margin-right: 8px;
    margin-bottom: 6px;
}
.prep-meter-chip.over { color: rgb(232, 106, 102); border-color: rgb(232, 106, 102); }

/* ---- form fields ---- */
.field { margin-bottom: 8px; }
.field-label { font-size: 11px; -unity-font-style: bold; color: rgb(150, 144, 165); letter-spacing: 1px; margin-bottom: 4px; }

/* Unity's TextField renders its editable area in a nested element — style that
   directly, otherwise it inherits the OS default (dark text on a light box). */
.text-input .unity-base-text-field__input,
.text-input .unity-base-field__input {
    background-color: rgb(24, 23, 31);
    color: rgb(237, 234, 242);
    border-color: rgb(64, 61, 78);
    border-width: 1px;
    border-radius: 6px;
    padding: 7px 9px;
    font-size: 14px;
    --unity-cursor-color: rgb(237, 234, 242);
    -unity-selection-color: rgb(60, 78, 120);
}
.text-input .unity-base-text-field__input:focus,
.text-input .unity-base-field__input:focus {
    border-color: rgb(231, 165, 68);
}

.swatch-row { flex-direction: row; flex-wrap: wrap; }
.swatch {
    width: 28px; height: 28px; border-radius: 6px; margin-right: 6px; margin-bottom: 5px;
    border-width: 3px; border-color: rgba(0,0,0,0);
    align-items: center; justify-content: center;
}
/* Fixed high-contrast ring so it reads on a light OR dark swatch. */
.swatch.selected { border-color: rgb(120, 170, 255); }
.swatch-check { font-size: 16px; -unity-font-style: bold; }

.diff-card {
    background-color: rgb(26, 25, 33);
    border-color: rgb(48, 46, 60);
    border-width: 1px;
    border-radius: 8px;
    padding: 8px;
    margin-bottom: 4px;
    margin-right: 6px;
    width: 47%;
    flex-grow: 1;
}
.diff-card.selected { border-color: rgb(231, 165, 68); background-color: rgb(35, 31, 27); }
.diff-name { -unity-font-style: bold; font-size: 14px; }

.toast {
    background-color: rgb(35, 31, 27);
    border-left-width: 3px;
    border-left-color: rgb(231, 165, 68);
    border-radius: 6px;
    padding: 10px 12px;
    margin-bottom: 8px;
}
.toast-story {
    background-color: rgb(30, 30, 40);
    border-left-color: rgb(120, 170, 255);
}
.toast-bad {
    background-color: rgb(38, 27, 27);
    border-left-color: rgb(232, 106, 102);
}
.chip-story {
    color: rgb(120, 170, 255);
    border-color: rgb(70, 100, 150);
}
.event-card {
    border-color: rgb(231, 165, 68);
    border-width: 2px;
    background-color: rgb(33, 30, 26);
}

/* ---- foldout ---- */
.help-foldout {
    background-color: rgb(26, 25, 33);
    border-color: rgb(48, 46, 60);
    border-width: 1px;
    border-radius: 8px;
    padding: 8px 12px;
    margin-bottom: 14px;
}
.help-foldout > .unity-foldout__toggle {
    -unity-font-style: bold;
}
.help-foldout .unity-foldout__toggle .unity-text-element {
    color: rgb(231, 165, 68);
    -unity-font-style: bold;
    font-size: 13px;
    letter-spacing: 1px;
}
.help-foldout .unity-foldout__content {
    margin-left: 4px;
    margin-top: 4px;
}
.unity-foldout__text { color: rgb(236, 233, 242); }

/* ---- tab bar ---- */
.tabbar {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
    margin-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(48, 46, 60);
}

.tab {
    -unity-font-definition: url("Fonts/PressStart2P-Regular.ttf");
    font-size: 11px;
    padding: 10px 14px;
    margin-right: 2px;
    margin-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(150, 144, 165);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
}
.tab:hover { background-color: rgba(0, 0, 0, 0); color: rgb(219, 215, 229); }
.tab.active { color: rgb(244, 242, 250); }

/* ---- toggles (setup screen modifiers) ---- */
.unity-toggle .unity-text-element { color: rgb(206, 202, 216); white-space: normal; }
.unity-toggle > .unity-toggle__input { margin-right: 8px; }
.unity-toggle__checkmark {
    background-color: rgb(24, 23, 31);
    border-color: rgb(90, 86, 104);
    border-width: 1px;
    border-radius: 4px;
}
.unity-toggle:checked .unity-toggle__checkmark {
    background-color: rgb(231, 165, 68);
}
